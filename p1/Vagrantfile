# Part 1 Vagrantfile (Step 04)
# VM 2대 + 고정 IP. Server에 K3s controller.

# 42 로그인. hostname은 LOGIN + "S"/"SW" → hyunkim2S / hyunkim2SW
LOGIN = "hyunkim2"

Vagrant.configure("2") do |config|
  # OS 이미지 (Debian 12). 첫 vagrant up 때 다운로드됨
  config.vm.box = "debian/bookworm64"
  # 시작할 때마다 box 업데이트 확인하지 않음
  config.vm.box_check_update = false

  # Server (나중에 K3s controller가 될 VM)
  config.vm.define "#{LOGIN}S" do |server|
    server.vm.hostname = "#{LOGIN}S"
    server.vm.network "private_network", ip: "192.168.56.110"

    server.vm.provider "virtualbox" do |vb|
      vb.name = "#{LOGIN}S" # VirtualBox에 보이는 이름
      vb.memory = 1024      # RAM 1024 MB (과제 권장 최소)
      vb.cpus = 1           # CPU 1개
      vb.gui = false
    end
    server.vm.provision "shell", path: "scripts/k3s-server.sh"
  end

  # ServerWorker (나중에 K3s agent가 될 VM)
  config.vm.define "#{LOGIN}SW" do |worker|
    worker.vm.hostname = "#{LOGIN}SW"
    worker.vm.network "private_network", ip: "192.168.56.111"

    worker.vm.provider "virtualbox" do |vb|
      vb.name = "#{LOGIN}SW" # VirtualBox에 보이는 이름
      vb.memory = 1024      # RAM 1024 MB (과제 권장 최소)
      vb.cpus = 1           # CPU 1개
      vb.gui = false
    end
  end
end
