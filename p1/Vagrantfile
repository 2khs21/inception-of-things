# Part 1 Vagrantfile (Step 02)
# VM 1대만. 고정 IP·Worker·K3s는 Step 03~04에서 추가.

# 42 로그인. hostname은 LOGIN + "S" → hyunkim2S
LOGIN = "hyunkim2"

Vagrant.configure("2") do |config|
  # OS 이미지 (Debian 12). 첫 vagrant up 때 다운로드됨
  config.vm.box = "debian/bookworm64"
  # 시작할 때마다 box 업데이트 확인하지 않음
  config.vm.box_check_update = false

  # Server (나중에 K3s controller가 될 VM)
  config.vm.define "#{LOGIN}S" do |server|
    server.vm.hostname = "#{LOGIN}S"

    server.vm.provider "virtualbox" do |vb|
      vb.name = "#{LOGIN}S" # VirtualBox에 보이는 이름
      vb.memory = 1024      # RAM 1024 MB (과제 권장 최소)
      vb.cpus = 1           # CPU 1개
    end
  end
end
